# Optional AI interpretation. Deterministic analysis works without any key.
# Only OpenAI-compatible endpoints are supported. Leave the key blank to stay offline.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CLAUSELENS_LLM_PROVIDER=openai
CLAUSELENS_LLM_MODEL=gpt-4o-mini
CLAUSELENS_ALLOW_EXTERNAL_LLM=true

# Processing limits and retrieval depth
CLAUSELENS_MAX_UPLOAD_MB=10
CLAUSELENS_MAX_PDF_PAGES=300
CLAUSELENS_TOP_K=8
CLAUSELENS_LLM_TIMEOUT_SECONDS=30
